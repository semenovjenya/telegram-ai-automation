# Telegram credentials are created in Telegram's official developer portal.
TELEGRAM_API_ID=replace-with-your-api-id
TELEGRAM_API_HASH=replace-with-your-api-hash

# Relative path inside parser_local. Session files authenticate the Telegram
# account and must never be committed or shared.
TELEGRAM_SESSION=telegram.session

# Optional AI analysis.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Parser limits.
MSG_LIMIT=100
AI_POSTS_LIMIT=50
